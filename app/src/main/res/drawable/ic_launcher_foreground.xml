<?xml version="1.0" encoding="utf-8"?>
<!--
  CarMirror launcher foreground: an iPhone (amber) in front of a car display (white) that shows
  the same phone, i.e. "phone mirrored onto the car screen". All art stays inside the central
  ~62dp of the 108dp adaptive canvas so circle and square masks never clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Car display -->
    <path
        android:pathData="M44,36 h28 a4,4 0 0 1 4,4 v18 a4,4 0 0 1 -4,4 h-28 a4,4 0 0 1 -4,-4 v-18 a4,4 0 0 1 4,-4 z"
        android:fillColor="#1A2530"
        android:strokeColor="#E8EEF2"
        android:strokeWidth="2.6"/>
    <!-- Display stand -->
    <path
        android:pathData="M58,62 v4 M52,67 h12"
        android:strokeColor="#E8EEF2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"/>
    <!-- Mirrored phone on the display -->
    <path
        android:pathData="M60,41 h4 a2,2 0 0 1 2,2 v12 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-12 a2,2 0 0 1 2,-2 z"
        android:fillColor="#99FFB547"/>
    <!-- iPhone in front -->
    <path
        android:pathData="M35,47 h8 a3,3 0 0 1 3,3 v19 a3,3 0 0 1 -3,3 h-8 a3,3 0 0 1 -3,-3 v-19 a3,3 0 0 1 3,-3 z"
        android:fillColor="#0F141A"
        android:strokeColor="#FFB547"
        android:strokeWidth="2.6"/>
    <path
        android:pathData="M37.5,51 h5"
        android:strokeColor="#FFB547"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"/>
</vector>
